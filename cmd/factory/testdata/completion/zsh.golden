$ factory completion zsh
exit 0
--- stdout
autoload -U +X bashcompinit && bashcompinit
# factory completion for bash; generated by 'factory completion bash'.
_factory() {
  local cur="${COMP_WORDS[COMP_CWORD]}" words=() w
  for w in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
    [[ $w == -* ]] || words+=("$w")
  done
  local typed="${words[*]}"
  case "$typed" in
    "migrate status" | "migrate status "*) COMPREPLY=($(compgen -W "--database-url" -- "$cur")) ;;
    "migrate down" | "migrate down "*) COMPREPLY=($(compgen -W "--database-url" -- "$cur")) ;;
    "work enqueue" | "work enqueue "*) COMPREPLY=($(compgen -W "--blocked-by --body --external-id --external-url --file --idempotency-key --output --priority --repos --requires --server --source --state --title" -- "$cur")) ;;
    "workers list" | "workers list "*) COMPREPLY=($(compgen -W "--output --server" -- "$cur")) ;;
    "completion" | "completion "*) COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur")) ;;
    "migrate up" | "migrate up "*) COMPREPLY=($(compgen -W "--database-url" -- "$cur")) ;;
    "work list" | "work list "*) COMPREPLY=($(compgen -W "--claimed-by --cursor --limit --output --repo --server --source --state" -- "$cur")) ;;
    "work move" | "work move "*) COMPREPLY=($(compgen -W "--output --reason --server" -- "$cur")) ;;
    "work show" | "work show "*) COMPREPLY=($(compgen -W "--output --server" -- "$cur")) ;;
    "migrate" | "migrate "*) COMPREPLY=($(compgen -W "down status up" -- "$cur")) ;;
    "workers" | "workers "*) COMPREPLY=($(compgen -W "list" -- "$cur")) ;;
    "doctor" | "doctor "*) COMPREPLY=($(compgen -W "--harnesses --output --server --work-dir --worker" -- "$cur")) ;;
    "status" | "status "*) COMPREPLY=($(compgen -W "--output --server" -- "$cur")) ;;
    "worker" | "worker "*) COMPREPLY=($(compgen -W "--contained --git-url --github-api-url --harnesses --sandbox --sandbox-key --token-file --url --work-dir" -- "$cur")) ;;
    "serve" | "serve "*) COMPREPLY=($(compgen -W "--addr --database-url --github-api-url --github-app-id --github-app-key-file --launcher --launcher-allowed-images --launcher-capabilities --launcher-image --launcher-limits --launcher-max-sandboxes --launcher-model-key-secret --launcher-namespace --launcher-node-selector --launcher-pending-timeout --launcher-poll-interval --launcher-requests --launcher-runtime-class --launcher-server-url --launcher-service-account --launcher-tolerations --lease --max-attempts --retry-delay --stuck-after" -- "$cur")) ;;
    "work" | "work "*) COMPREPLY=($(compgen -W "enqueue list move show" -- "$cur")) ;;
    "") COMPREPLY=($(compgen -W "completion doctor migrate serve status version work worker workers" -- "$cur")) ;;
  esac
}
complete -F _factory factory
--- stderr
