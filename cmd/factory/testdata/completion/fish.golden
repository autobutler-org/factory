$ factory completion fish
exit 0
--- stdout
# factory completion for fish; generated by 'factory completion fish'.
function __factory_at
    set -l t (commandline -opc)
    set -e t[1]
    set -l typed (string join ' ' (string match -v -- '-*' $t) | string collect)
    for p in 'migrate status' 'migrate down' 'work enqueue' 'workers list' 'completion' 'migrate up' 'work list' 'work move' 'work show' 'migrate' 'workers' 'doctor' 'status' 'worker' 'serve' 'work' ''
        if test "$typed" = "$p"; or string match -q -- "$p *" "$typed"
            test "$p" = "$argv[1]"
            return
        end # if
    end
    return 1
end
complete -c factory -f
complete -c factory -n "__factory_at 'migrate status'" -l database-url
